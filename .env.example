# Copy to .env and fill in values: cp .env.example .env
# Never commit .env

DJANGO_SECRET_KEY=change-me-in-production

# Demo without API keys: set to 1 for canned responses (disable for real runs)
MOCK_LLM=0

# OpenAI — baseline model + LLM-as-judge
OPENAI_API_KEY=

# Baseten — Model API (managed LLMs): full URL to chat completions
BASETEN_API_KEY=
BASETEN_DEPLOYMENT_URL=https://inference.baseten.co/v1/chat/completions
# Model slug from Baseten’s catalog (swap if your account uses a custom deployment URL instead)
BASETEN_MODEL_ID=deepseek-ai/DeepSeek-V3.1
# Custom Truss deploys use a different host, e.g. https://model-XXXX.api.baseten.co/production/predict

# Optional: Veris CLI path if ``veris`` is not on PATH when Django starts (e.g. pipx)
VERIS_CLI_PATH=

# Optional: Veris (console.veris.ai) — key may also live in ~/.veris/config.yaml after veris login
VERIS_API_KEY=

# CORS: comma-separated origins for React dev server, e.g. http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
