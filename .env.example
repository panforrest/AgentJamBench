# Copy to .env and fill in values: cp .env.example .env
# Never commit .env

DJANGO_SECRET_KEY=change-me-in-production

# OpenAI — baseline model + LLM-as-judge
OPENAI_API_KEY=

# Baseten — inference endpoint (see Baseten docs for your deployment URL / model id)
BASETEN_API_KEY=
BASETEN_DEPLOYMENT_URL=
# Optional: some OpenAI-compatible Baseten endpoints expect a model id
BASETEN_MODEL_ID=

# Optional: Veris (console.veris.ai) if you wire API or import packs
VERIS_API_KEY=

# CORS: comma-separated origins for React dev server, e.g. http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
